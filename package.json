{
  "name": "j-communities",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ./client/vite.config.ts",
    "dev:server": "node server.js",
    "build": "vite build --config ./client/vite.config.ts",
    "start": "node server.js",
    "preview": "vite preview --config ./client/vite.config.ts",
    "test": "vitest --config ./client/vite.config.ts",
    "test:run": "vitest run --config ./client/vite.config.ts",
    "compress:models": "npx @gltf-transform/cli optimize client/public/assets/models/**/*.glb --output client/public/assets/models/ --compress draco",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "deploy:vps": "prisma migrate deploy && prisma generate && npm run build",
    "admin:hash-password": "node scripts/hash-password.js",
    "admin:set-password": "node scripts/set-admin-password.js",
    "admin:verify-env": "node scripts/verify-admin-env.js",
    "admin:generate-key": "node scripts/generate-key.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lenis": "^1.3.23",
    "nodemailer": "^7.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
