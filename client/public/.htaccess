# Hostinger shared hosting (Apache / LiteSpeed): React Router SPA fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Campaign-friendly short URL: old Jamila slug → /projects/jamila
  RewriteRule ^projects/jamila-north-coast/?$ /projects/jamila [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
