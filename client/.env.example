# Public site origin (no trailing slash). Used for canonical + Open Graph URLs in the client.
VITE_SITE_ORIGIN=https://www.j-communities.com

# Cloudflare Turnstile site key (public). Create at Cloudflare Dashboard → Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Google Ads conversion send_to (public). From Google Ads → Goals → Conversions → Tag setup.
# Example: AW-18364435114/AbCdEfGhIjK
VITE_GOOGLE_ADS_CONVERSION_SEND_TO=
