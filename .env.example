# Server — copy to .env and fill secrets (never commit .env)
PORT=3000
NODE_ENV=production

# Session signing secret — min 32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin login
ADMIN_USERNAME=admin
# npm run admin:hash-password -- your-password  (prints hash only)
# npm run admin:set-password -- your-password   (writes .env safely on server)
ADMIN_PASSWORD_HASH=

# PII encryption at rest — npm run admin:generate-key
LEAD_ENCRYPTION_KEY=

# Public site URL (Cloudflare / canonical). Include apex + www in ALLOWED_ORIGINS.
SITE_ORIGIN=https://www.j-communities.com
ALLOWED_ORIGINS=https://www.j-communities.com,https://j-communities.com

DATABASE_URL="file:./data/leads.db"

# InMotion / domain mailbox (preferred for j-communities.com)
NOTIFY_EMAIL=info@j-communities.com
SMTP_HOST=mail.j-communities.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@j-communities.com
SMTP_PASS=
SMTP_FROM="J Communities Leads <info@j-communities.com>"

# Optional Resend fallback (leave empty if using SMTP)
RESEND_API_KEY=

# Treat same phone + project resubmissions within this window as duplicate spam (default 24)
# DUPLICATE_WINDOW_HOURS=24

# Public form anti-spam (popup + contact)
# LEAD_MIN_SUBMIT_MS=2500
# LEAD_MAX_SUBMIT_MS=7200000
# LEAD_PHONE_MAX_PER_HOUR=3

# Cloudflare Turnstile (Dashboard → Turnstile → your widget)
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=j-communities.com,www.j-communities.com

# SESSION_MAX_AGE_MS=43200000
