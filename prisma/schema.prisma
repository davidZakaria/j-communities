generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LeadSource {
  contact
  popup
}

enum LeadStatus {
  new
  contacted
  qualified
  closed
  spam
}

enum NewsCategory {
  press
  social
}

enum NewsLanguage {
  en
  ar
}

model NewsArticle {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  slug          String       @unique
  title         String
  excerpt       String
  body          String
  publishedAt   DateTime
  source        String
  externalUrl   String?
  category      NewsCategory
  language      NewsLanguage
  featured      Boolean      @default(false)
  published     Boolean      @default(true)
  coverImageUrl String?

  @@index([publishedAt])
  @@index([published])
  @@index([featured])
  @@index([category])
}

model Lead {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String
  phone       String
  message     String?
  projectName String
  projectSlug String
  themeId     String
  source      LeadSource
  pageUrl     String?
  userAgent   String?
  ipHash      String?
  status      LeadStatus @default(new)
  notes       String?
  phoneFingerprint String?
  duplicateOfId    String?

  @@index([createdAt])
  @@index([projectSlug])
  @@index([status])
  @@index([phoneFingerprint, projectSlug])
}
